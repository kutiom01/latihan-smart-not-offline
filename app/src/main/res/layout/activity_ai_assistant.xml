<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F7FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:id="@+id/tvBackAI"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Kembali"
            android:textColor="#6C63FF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="AI Assistant"
            android:textColor="#202033"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Asisten pintar untuk membantu mengolah catatanmu secara offline."
            android:textColor="#777788"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etAIInput"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="28dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Masukkan catatan yang ingin diringkas..."
            android:padding="16dp"
            android:textSize="15sp" />

        <Button
            android:id="@+id/btnProcessAI"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="18dp"
            android:backgroundTint="#6C63FF"
            android:text="✦ Proses dengan AI"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tvAIResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="Hasil AI akan ditampilkan di sini."
            android:textColor="#777788"
            android:textSize="15sp" />

    </LinearLayout>

</ScrollView>
